// Prisma schema for SEO Optimizer (Phases 1-3)
// SQLite for local agency use; easy to migrate to Postgres later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  clients   Client[]
  projects  Project[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  createdAt      DateTime @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  projects       Project[]

  @@index([organizationId])
}

model Project {
  id                  String   @id @default(cuid())
  name                String
  websiteUrl          String
  domain              String
  businessLocation    String?
  industry            String?
  primaryCategory     String?
  targetServiceArea   String?
  gbpUrl              String?
  organizationId      String
  ownerId             String
  clientId            String?
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  crawls      Crawl[]
  urls        Url[]
  opportunities Opportunity[]

  @@index([organizationId])
  @@index([ownerId])
}

model Crawl {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        String   @default("queued") // queued | running | completed | failed
  currentStep   String?  // human readable step
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  error         String?
  pagesCrawled  Int      @default(0)
  totalDiscovered Int    @default(0)
  config        String?  // JSON string: CrawlConfig
  stats         String?  // JSON string: aggregated counts

  urls          Url[]
  findings      AuditFinding[]

  @@index([projectId])
}

model Url {
  id                 String   @id @default(cuid())
  projectId          String
  crawlId            String
  url                String // raw discovered URL
  normalizedUrl      String // dedupe key
  httpStatus         Int?
  finalUrl           String?
  redirectChain      String? // JSON string: array of {url,status}
  indexability       String? // crawlable|indexable|non-indexable|blocked|redirected|canonicalized
  canonicalUrl       String?
  metaTitle          String?
  metaTitleLength    Int?
  metaDescription    String?
  metaDescriptionLength Int?
  h1                 String?
  h1Count            Int?
  h2Count            Int?
  wordCount          Int?
  internalLinks      Int?
  externalLinks      Int?
  images             Int?
  imagesMissingAlt   Int?
  robotsMeta         String?
  xRobotsTag         String?
  inSitemap          Boolean?
  crawlDepth         Int?
  discoveredAt       DateTime @default(now())
  contentHash        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawl   Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([crawlId])
  @@index([normalizedUrl])
  @@index([httpStatus])
  @@index([indexability])
  @@index([inSitemap])
}

model AuditFinding {
  id            String   @id @default(cuid())
  crawlId       String
  projectId     String
  crawl         Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  category      String   // title|description|headings|indexability|technical|images|links|performance
  severity      String   // critical|high|medium|low
  title         String
  description   String
  affectedUrls  String   // JSON array of URLs
  recommendation String
  evidence      String   // JSON array of evidence strings
  count         Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([crawlId])
  @@index([projectId])
  @@index([severity])
  @@index([category])
}

model Opportunity {
  id            String   @id @default(cuid())
  projectId     String
  crawlId       String
  category      String
  issue         String
  severity      String
  impact        Int      // 1-10
  confidence    Int      // 1-10
  effort        Int      // 1-10
  priorityScore Float    // impact * confidence / effort
  affectedUrls  String   // JSON array
  recommendation String
  evidence      String   // JSON array
  status        String   @default("new") // new|reviewed|planned|in_progress|completed|ignored
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([crawlId])
  @@index([status])
  @@index([priorityScore])
}
